{
  "name": "starfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "STARFALL - a 1982-that-never-was space arcade game. TypeScript + WebGL2 + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playtest": "node playtest/run.mjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
